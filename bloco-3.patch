+"use client";
+
+import Link from "next/link";
+import { useEffect, useMemo, useState } from "react";
+
+type Video = {
+  id: string;
+  video_id: string;
+  titulo: string;
+  url: string;
+  thumbnail_url: string | null;
+  tipo: "video" | "short" | "live";
+  publicado_em: string | null;
+  coletado_em: string;
+  fonte_nome: string;
+  metadados: Record<string, unknown>;
+};
+
+const API_URL = "/backend";
+
+export default function VideosPage() {
+  const [videos, setVideos] = useState<Video[]>([]);
+  const [busca, setBusca] = useState("");
+  const [loading, setLoading] = useState(true);
+  const [erro, setErro] = useState<string | null>(null);
+
+  useEffect(() => {
+    let ativo = true;
+    setLoading(true);
+    fetch(`${API_URL}/api/videos?limit=50&offset=0`, { cache: "no-store" })
+      .then((response) => {
+        if (!response.ok) throw new Error(`API de vídeos respondeu ${response.status}`);
+        return response.json() as Promise<Video[]>;
+      })
+      .then((data) => {
+        if (!ativo) return;
+        setVideos(data);
+        setErro(null);
+      })
+      .catch((error) => {
+        if (!ativo) return;
+        setErro(error instanceof Error ? error.message : "Falha ao carregar vídeos.");
+      })
+      .finally(() => {
+        if (ativo) setLoading(false);
+      });
+    return () => {
+      ativo = false;
+    };
+  }, []);
+
+  const videosFiltrados = useMemo(() => {
+    const termo = busca.trim().toLocaleLowerCase("pt-BR");
+    if (!termo) return videos;
+    return videos.filter((video) =>
+      [video.titulo, video.fonte_nome]
+        .filter(Boolean)
+        .some((valor) => valor.toLocaleLowerCase("pt-BR").includes(termo))
+    );
+  }, [busca, videos]);
+
+  return (
+    <main style={{ maxWidth: 1180, margin: "0 auto", padding: "32px 20px 60px" }}>
+      <nav style={{ display: "flex", gap: 20, marginBottom: 28 }}>
+        <Link href="/">Início</Link>
+        <strong>Vídeos</strong>
+      </nav>
+
+      <header style={{ marginBottom: 24 }}>
+        <p className="eyebrow">CENTRAL DO GALO</p>
+        <h1>Vídeos do Atlético</h1>
+      </header>
+
+      <label style={{ display: "grid", gap: 8, marginBottom: 24 }}>
+        <span className="filter-label">Buscar vídeos</span>
+        <input
+          type="search"
+          value={busca}
+          onChange={(event) => setBusca(event.target.value)}
+          placeholder="Buscar por termo, jogador, treino..."
+          style={{ minHeight: 44, padding: "0 14px", borderRadius: 12, border: "1px solid #d7d7d2" }}
+        />
+      </label>
+
+      {loading && <div className="state-card">Carregando vídeos...</div>}
+      {erro && <div className="state-card error-card">{erro}</div>}
+      {!loading && !erro && videosFiltrados.length === 0 && (
+        <div className="state-card">Nenhum vídeo encontrado.</div>
+      )}
+
+      {!loading && !erro && videosFiltrados.length > 0 && (
+        <section style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(240px, 1fr))", gap: 18 }}>
+          {videosFiltrados.map((video) => (
+            <a key={video.id} href={video.url} target="_blank" rel="noopener noreferrer" style={{ color: "inherit", textDecoration: "none" }}>
+              <img
+                src={video.thumbnail_url || `https://i.ytimg.com/vi/${video.video_id}/hqdefault.jpg`}
+                alt=""
+                style={{ width: "100%", aspectRatio: "16 / 9", objectFit: "cover", borderRadius: 14 }}
+              />
+              <strong style={{ display: "block", marginTop: 10 }}>{video.titulo}</strong>
+              <span style={{ display: "block", marginTop: 4, fontSize: 13, opacity: 0.68 }}>{video.fonte_nome}</span>
+            </a>
+          ))}
+        </section>
+      )}
+    </main>
+  );
+}
