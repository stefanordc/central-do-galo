def _item_value(item: dict[str, Any], lado: str) -> tuple[float | None, str | None]:
    numeric = item.get(f"{lado}Value")
    number = _to_number(numeric)
    display = item.get(lado)
    if number is None:
        number = _to_number(display)
    return number, str(display) if display is not None else None


def _infer_unit(display: str | None, name: str) -> str | None:
    display = display or ""
    lower = name.lower()
    if "%" in display or "percentage" in lower or "possession" in lower or "accuracy" in lower:
        return "%"
    if "km" in display or "distance" in lower:
        return "km"
    return None


def dados_coletivos(ano: int) -> dict[str, Any]:
    rows = _linhas_estatisticas_coletivas(ano)

    vitorias = empates = derrotas = 0
    gols_pro = gols_contra = 0
    agregados: dict[str, dict[str, Any]] = {}

    for row in rows:
        lado = row["lado_galo"]
        gm = row.get("gols_mandante")
        gv = row.get("gols_visitante")
        if gm is not None and gv is not None:
            pro = int(gm if lado == "home" else gv)
            contra = int(gv if lado == "home" else gm)
            gols_pro += pro
            gols_contra += contra
            if pro > contra:
                vitorias += 1
            elif pro == contra:
                empates += 1
            else:
                derrotas += 1

        payload = row.get("estatisticas") or {}
        if isinstance(payload, str):
            try:
                payload = json.loads(payload)
            except Exception:
                payload = {}

        periods = payload.get("statistics") or []
        period_all = next(
            (p for p in periods if str(p.get("period") or "").upper() == "ALL"),
            periods[0] if periods else {},
        )

        for group in period_all.get("groups") or []:
            group_name = str(group.get("groupName") or "Outros")
            for item in group.get("statisticsItems") or []:
                if not isinstance(item, dict):
                    continue
                name = str(item.get("name") or item.get("key") or "").strip()
                if not name:
                    continue
                key = str(item.get("key") or name)
                value, display = _item_value(item, lado)
                if value is None:
                    continue

                bucket = agregados.setdefault(
                    key,
                    {
                        "chave": key,
                        "nome": name,
                        "grupo": group_name,
                        "unidade": _infer_unit(display, name),
                        "soma": 0.0,
                        "contagem": 0,
                    },
                )
                bucket["soma"] += value
                bucket["contagem"] += 1

    jogos = len(rows)
    pontos = vitorias * 3 + empates
    aproveitamento = round((pontos / (jogos * 3) * 100), 1) if jogos else 0.0

    metricas = []
    for bucket in agregados.values():
        count = bucket["contagem"]
        media = bucket["soma"] / count if count else 0
        metricas.append(
            {
                "chave": bucket["chave"],
                "nome": bucket["nome"],
                "grupo": bucket["grupo"],
                "unidade": bucket["unidade"],
                "media": round(media, 2),
                "total": round(bucket["soma"], 2),
                "jogos_com_dado": count,
            }
        )

    ordem_preferida = {
        "ballPossession": 1,
        "totalShotsOnGoal": 2,
        "shotsOnGoal": 2,
        "totalShots": 3,
        "goalAttempts": 3,
        "bigChanceCreated": 4,
        "bigChances": 4,
        "cornerKicks": 5,
        "accuratePasses": 6,
        "passes": 7,
        "fouls": 8,
        "yellowCards": 9,
        "expectedGoals": 10,
        "distanceCovered": 11,
        "sprints": 12,
    }
    metricas.sort(key=lambda x: (ordem_preferida.get(x["chave"], 999), x["grupo"], x["nome"]))

    return {
        "ano": ano,
        "resumo": {
            "jogos": jogos,
            "vitorias": vitorias,
            "empates": empates,
            "derrotas": derrotas,
            "gols_pro": gols_pro,
            "gols_contra": gols_contra,
            "aproveitamento": aproveitamento,
        },
        "metricas": metricas,
    }


