            p.nome,
            p.posicao,
            p.camisa,
            p.titular,
            p.estatisticas,
            j.inicio_em
        from public.estatisticas_jogadores_sofascore p
        join public.jogos j on j.id = p.jogo_id
        where {_ano_sql()}
          and j.status = 'finalizado'
        order by j.inicio_em asc
    """
    with pool.connection() as conn:
        with conn.cursor() as cur:
            cur.execute(sql, (ano,))
            colunas = [desc.name for desc in cur.description]
            return [dict(zip(colunas, row, strict=True)) for row in cur.fetchall()]


def dados_individuais(ano: int) -> dict[str, Any]:
    rows = _linhas_individuais(ano)
    jogadores: dict[int, dict[str, Any]] = {}

    for row in rows:
        stats = row.get("estatisticas") or {}
        if isinstance(stats, str):
            try:
                stats = json.loads(stats)
            except Exception:
                stats = {}

        # Jogadores que ficaram no banco sem entrar costumam vir sem statistics.
        if not stats:
            continue

        jogador_id = int(row["jogador_id"])
        item = jogadores.setdefault(
            jogador_id,
            {
                "jogador_id": jogador_id,
                "nome": row["nome"],
                "posicao": row.get("posicao"),
                "camisa": row.get("camisa"),
                "jogos": 0,
                "titular": 0,
                "minutos": 0.0,
                "gols": 0.0,
                "assistencias": 0.0,
                "rating_soma": 0.0,
                "rating_count": 0,
                "finalizacoes": 0.0,
                "passes_certos": 0.0,
                "passes_chave": 0.0,
                "desarmes": 0.0,
                "interceptacoes": 0.0,
                "duelos_ganhos": 0.0,
            },
        )

        item["nome"] = row["nome"] or item["nome"]
        item["posicao"] = row.get("posicao") or item["posicao"]
        item["camisa"] = row.get("camisa") if row.get("camisa") is not None else item["camisa"]
        item["jogos"] += 1
        if row.get("titular"):
            item["titular"] += 1

        item["minutos"] += _first_number(stats, "minutesPlayed")
        item["gols"] += _first_number(stats, "goals")
        item["assistencias"] += _first_number(stats, "goalAssist", "assists")
        item["finalizacoes"] += _first_number(stats, "totalShots", "totalShot")
        item["passes_certos"] += _first_number(stats, "accuratePass")
        item["passes_chave"] += _first_number(stats, "keyPass")
        item["desarmes"] += _first_number(stats, "totalTackle", "tackles")
        item["interceptacoes"] += _first_number(stats, "interceptionWon", "interceptions")
        item["duelos_ganhos"] += _first_number(stats, "duelWon")

        rating = _to_number(stats.get("rating"))
        if rating is not None:
            item["rating_soma"] += rating
            item["rating_count"] += 1

    resultado: list[dict[str, Any]] = []
    for item in jogadores.values():
        rating = (
            round(item["rating_soma"] / item["rating_count"], 2)
            if item["rating_count"]
            else None
        )
        resultado.append(
            {
                "jogador_id": item["jogador_id"],
                "nome": item["nome"],
                "posicao": item["posicao"],
                "camisa": item["camisa"],
                "foto_url": f"https://img.sofascore.com/api/v1/player/{item['jogador_id']}/image",
                "jogos": int(item["jogos"]),
                "titular": int(item["titular"]),
                "minutos": int(round(item["minutos"])),
                "gols": int(round(item["gols"])),
                "assistencias": int(round(item["assistencias"])),
                "nota_media": rating,
                "finalizacoes": int(round(item["finalizacoes"])),
                "passes_certos": int(round(item["passes_certos"])),
                "passes_chave": int(round(item["passes_chave"])),
                "desarmes": int(round(item["desarmes"])),
                "interceptacoes": int(round(item["interceptacoes"])),
                "duelos_ganhos": int(round(item["duelos_ganhos"])),
            }
        )

    resultado.sort(
        key=lambda x: (
            -x["minutos"],
            POSICOES_ORDEM.get(str(x.get("posicao") or ""), 99),
            x["nome"],
        )
    )
    return {"ano": ano, "jogadores": resultado}
