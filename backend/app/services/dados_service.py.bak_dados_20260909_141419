    jogadores, colunas = _agregar_individual(rows)
    return {
        "temporada": temporada,
        "campeonato": campeonato,
        "jogador_id": jogador_id,
        "posicao": posicao,
        "colunas": colunas,
        "jogadores": jogadores,
    }


