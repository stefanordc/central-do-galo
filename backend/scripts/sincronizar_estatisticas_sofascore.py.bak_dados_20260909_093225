from __future__ import annotations

import argparse
import json
import logging
import sys
from datetime import datetime
from pathlib import Path

BACKEND_DIR = Path(__file__).resolve().parents[1]
if str(BACKEND_DIR) not in sys.path:
    sys.path.insert(0, str(BACKEND_DIR))

from app.db.pool import pool
from app.services.dados_service import sincronizar_estatisticas_sofascore
from app.services.jogo_service import fechar_cliente_sofascore

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Coleta estatísticas coletivas e individuais do Sofascore."
    )
    parser.add_argument(
        "--ano",
        type=int,
        default=datetime.now().year,
        help="Ano dos jogos a processar. Ex.: 2026.",
    )
    parser.add_argument(
        "--limite",
        type=int,
        default=None,
        help="Limita a quantidade de jogos nesta execução.",
    )
    parser.add_argument(
        "--forcar",
        action="store_true",
        help="Refaz estatísticas de jogos que já foram coletados.",
    )
    args = parser.parse_args()

    pool.open()
    try:
        resultado = sincronizar_estatisticas_sofascore(
            args.ano,
            forcar=args.forcar,
            limite=args.limite,
        )
        print(json.dumps(resultado, ensure_ascii=False, indent=2, default=str))
    finally:
        fechar_cliente_sofascore()
        pool.close()


if __name__ == "__main__":
    main()
