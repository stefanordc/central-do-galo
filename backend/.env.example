APP_NAME=Central do Galo API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

NEWS_COLLECTION_ENABLED=true
NEWS_COLLECTION_INTERVAL_SECONDS=300
NEWS_COLLECTION_INITIAL_DELAY_SECONDS=2
NEWS_COLLECTION_REQUEST_DELAY_SECONDS=0.6

# Radar do X - scraping público via SeleniumBase UC, sem login
X_SOURCE=scrape
X_SYNC_ENABLED=true
X_SYNC_SECRET=
X_SCRAPE_PROFILE_DIR=.x_public_uc_profile
X_SCRAPE_HEADLESS=true
X_SCRAPE_INTERVAL_SECONDS=3600
X_SCRAPE_INITIAL_DELAY_SECONDS=15
X_SCRAPE_PAGE_TIMEOUT_SECONDS=45
X_SCRAPE_RENDER_WAIT_SECONDS=2
X_SCRAPE_TIMELINE_WAIT_SECONDS=18
X_SCRAPE_SCROLL_PAUSE_SECONDS=2.5
X_SCRAPE_DEBUG_ENABLED=true
X_SCRAPE_DEBUG_DIR=.radar_x_debug
X_SCRAPE_DELAY_BETWEEN_ACCOUNTS_SECONDS=30
X_SCRAPE_MAX_SCROLLS=6
X_SCRAPE_POSTS_PER_ACCOUNT=3
X_SCRAPE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"

# Mantidos apenas para eventual retorno à API oficial.
X_BEARER_TOKEN=
X_SYNC_INTERVAL_SECONDS=900
X_SYNC_INITIAL_DELAY_SECONDS=5
X_SYNC_TIMEOUT_SECONDS=30
X_SYNC_FETCH_LIMIT=10

# YouTube - vídeos, Shorts e transmissões públicas
YOUTUBE_SYNC_ENABLED=true
YOUTUBE_SYNC_INTERVAL_SECONDS=900
YOUTUBE_SYNC_INITIAL_DELAY_SECONDS=8
YOUTUBE_ITEMS_PER_SECTION=10
YOUTUBE_SCRAPE_HEADLESS=true
YOUTUBE_SCRAPE_PAGE_TIMEOUT_SECONDS=45
YOUTUBE_SCRAPE_WAIT_SECONDS=20
YOUTUBE_SCRAPE_SCROLL_PAUSE_SECONDS=1.5
YOUTUBE_SCRAPE_MAX_SCROLLS=6
YOUTUBE_SCRAPE_PROFILE_DIR=.youtube_public_uc_profile
YOUTUBE_SCRAPE_DEBUG_ENABLED=true
YOUTUBE_SCRAPE_DEBUG_DIR=.youtube_debug
