{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/noticias",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/youtube",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/x",
      "schedule": "0 * * * *"
    }
  ]
}