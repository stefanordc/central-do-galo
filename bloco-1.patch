--- a/backend/app/services/source_service.py
+++ b/backend/app/services/source_service.py
@@
+import re
+import unicodedata
+from urllib.parse import urlparse
+
 from app.db.pool import pool
@@
 def listar_fontes() -> list[dict]:
@@
             colunas = [desc.name for desc in cur.description]
             return [dict(zip(colunas, row, strict=True)) for row in cur.fetchall()]
+
+
+def _slugify(valor: str) -> str:
+    normalizado = unicodedata.normalize("NFD", valor)
+    sem_acentos = "".join(char for char in normalizado if unicodedata.category(char) != "Mn")
+    return re.sub(r"[^a-z0-9]+", "-", sem_acentos.lower()).strip("-")
+
+
+def _extrair_handle_youtube(url_ou_handle: str) -> str:
+    valor = url_ou_handle.strip()
+    if not valor:
+        raise ValueError("Informe a URL ou o @handle do canal.")
+
+    if valor.startswith("@"):
+        handle = valor
+    else:
+        if not re.match(r"^https?://", valor, flags=re.IGNORECASE):
+            valor = f"https://{valor}"
+        parsed = urlparse(valor)
+        if parsed.netloc.lower() not in {"youtube.com", "www.youtube.com", "m.youtube.com"}:
+            raise ValueError("Informe uma URL válida do YouTube.")
+        partes = [parte for parte in parsed.path.split("/") if parte]
+        handle = next((parte for parte in partes if parte.startswith("@")), "")
+
+    if not re.fullmatch(r"@[A-Za-z0-9._-]+", handle):
+        raise ValueError("Não foi possível identificar o @handle do canal do YouTube.")
+    return handle
+
+
+def listar_canais_youtube_admin() -> list[dict]:
+    sql = """
+        select
+            id,
+            nome,
+            slug,
+            url_base,
+            confiabilidade,
+            oficial,
+            ativo,
+            configuracao
+        from public.fontes
+        where tipo = 'youtube'
+        order by ativo desc, oficial desc, confiabilidade desc, nome asc
+    """
+    with pool.connection() as conn:
+        with conn.cursor() as cur:
+            cur.execute(sql)
+            colunas = [desc.name for desc in cur.description]
+            return [dict(zip(colunas, row, strict=True)) for row in cur.fetchall()]
+
+
+def criar_canal_youtube(*, nome: str, url: str, oficial: bool, confiabilidade: int) -> dict:
+    nome_limpo = nome.strip()
+    if len(nome_limpo) < 2:
+        raise ValueError("Informe o nome do canal.")
+
+    handle = _extrair_handle_youtube(url)
+    handle_sem_arroba = handle[1:]
+    slug = f"youtube-{_slugify(handle_sem_arroba)}"
+    url_base = f"https://www.youtube.com/{handle}"
+    configuracao = {
+        "handle": handle,
+        "plataforma": "youtube",
+        "videos_url": f"{url_base}/videos",
+        "shorts_url": f"{url_base}/shorts",
+        "streams_url": f"{url_base}/streams",
+    }
+
+    sql = """
+        insert into public.fontes (
+            nome,
+            slug,
+            tipo,
+            url_base,
+            confiabilidade,
+            oficial,
+            ativo,
+            configuracao
+        )
+        values (%s, %s, 'youtube', %s, %s, %s, true, %s::jsonb)
+        returning id, nome, slug, url_base, confiabilidade, oficial, ativo, configuracao
+    """
+
+    import json
+
+    with pool.connection() as conn:
+        with conn.cursor() as cur:
+            cur.execute(
+                sql,
+                (
+                    nome_limpo,
+                    slug,
+                    url_base,
+                    confiabilidade,
+                    oficial,
+                    json.dumps(configuracao, ensure_ascii=False),
+                ),
+            )
+            row = cur.fetchone()
+            colunas = [desc.name for desc in cur.description]
+        conn.commit()
+
+    return dict(zip(colunas, row, strict=True))

