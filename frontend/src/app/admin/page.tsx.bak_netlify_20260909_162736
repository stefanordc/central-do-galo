  async function normalizarImagemColada(arquivo: File): Promise<string> {
    const original = await new Promise<string>((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result ?? ""));
      reader.onerror = () => reject(new Error("Não foi possível ler a imagem."));
      reader.readAsDataURL(arquivo);
    });

    return await new Promise<string>((resolve) => {
      const imagem = new Image();
      imagem.onload = () => {
        const maximo = 900;
        const escala = Math.min(1, maximo / Math.max(imagem.width, imagem.height));
        const largura = Math.max(1, Math.round(imagem.width * escala));
        const altura = Math.max(1, Math.round(imagem.height * escala));
        const canvas = document.createElement("canvas");
        canvas.width = largura;
        canvas.height = altura;
        const contexto = canvas.getContext("2d");
        if (!contexto) {
          resolve(original);
          return;
        }
        contexto.drawImage(imagem, 0, 0, largura, altura);
        // WEBP reduz bastante o peso e acelera o carregamento dos cards do elenco.
        resolve(canvas.toDataURL("image/webp", 0.82));
      };
      imagem.onerror = () => resolve(original);
      imagem.src = original;
    });
  }

  async function normalizarFotoExistente(url: string): Promise<string> {
    const response = await fetch(url, { cache: "no-store" });
    if (!response.ok) {
      throw new Error(`Não foi possível baixar a foto (${response.status}).`);
    }

    const blob = await response.blob();
    const objectUrl = URL.createObjectURL(blob);

    try {
      return await new Promise<string>((resolve, reject) => {
        const imagem = new Image();
        imagem.onload = () => {
          const maximo = 900;
          const escala = Math.min(1, maximo / Math.max(imagem.width, imagem.height));
          const largura = Math.max(1, Math.round(imagem.width * escala));
          const altura = Math.max(1, Math.round(imagem.height * escala));
          const canvas = document.createElement("canvas");
          canvas.width = largura;
          canvas.height = altura;
          const contexto = canvas.getContext("2d");
          if (!contexto) {
            reject(new Error("Não foi possível preparar a foto para otimização."));
            return;
          }
          contexto.drawImage(imagem, 0, 0, largura, altura);
          resolve(canvas.toDataURL("image/webp", 0.82));
        };
        imagem.onerror = () => reject(new Error("Não foi possível abrir a foto."));
        imagem.src = objectUrl;
      });
    } finally {
      URL.revokeObjectURL(objectUrl);
    }
  }

  async function otimizarFotosElenco() {
    const comFoto = jogadores.filter((jogador) => jogador.foto_url);
    if (!comFoto.length) {
      setMensagem("Não há fotos cadastradas para otimizar.");
      return;
    }

    if (!window.confirm(`Otimizar ${comFoto.length} foto(s) do elenco? Esse processo pode levar alguns minutos.`)) {
      return;
    }

    setOtimizandoFotos(true);
    let sucesso = 0;
    let falhas = 0;

    try {
      for (let indice = 0; indice < comFoto.length; indice += 1) {
        const jogador = comFoto[indice];
        setMensagem(`Otimizando foto ${indice + 1}/${comFoto.length}: ${jogador.nome_guerra}`);

        try {
          const fotoDataUrl = await normalizarFotoExistente(jogador.foto_url!);
          const response = await fetch(`${API_URL}/api/admin/elenco/${jogador.id}`, {
            method: "PUT",
            headers: { "Content-Type": "application/json", ...authHeaders },
            body: JSON.stringify({
              nome_completo: jogador.nome_completo,
              nome_guerra: jogador.nome_guerra,
              posicao: jogador.posicao,
              nacionalidade: jogador.nacionalidade || "Brasil",
              nascimento: jogador.nascimento,
              numero: jogador.posicao === "Técnico" ? null : jogador.numero,
              foto_data_url: fotoDataUrl,
              remover_foto: false,
            }),
          });

          if (!response.ok) {
            throw new Error(`API respondeu ${response.status}.`);
          }
          sucesso += 1;
        } catch {
          falhas += 1;
        }
      }

      await carregarDados();
      setMensagem(
        falhas
          ? `Otimização concluída: ${sucesso} foto(s) otimizadas e ${falhas} com falha.`
          : `Otimização concluída: ${sucesso} foto(s) ficaram mais leves.`
      );
    } finally {
      setOtimizandoFotos(false);
    }
  }

  async function colarFotoJogador(event: ClipboardEvent<HTMLElement>) {
    let arquivo: File | null = null;

    for (let indice = 0; indice < event.clipboardData.items.length; indice += 1) {
      const item = event.clipboardData.items[indice];
      if (item.type.startsWith("image/")) {
        arquivo = item.getAsFile();
        if (arquivo) break;
      }
    }

    if (!arquivo) {
      setMensagem("A área de transferência não contém uma imagem.");
      return;
    }

    event.preventDefault();

    try {
      const dataUrl = await normalizarImagemColada(arquivo);
      setFotoJogadorDataUrl(dataUrl);
      setFotoJogadorPreview(dataUrl);
      setRemoverFotoJogador(false);
      setMensagem("Foto colada. Salve o jogador para gravá-la.");
    } catch (error) {
      setMensagem(error instanceof Error ? error.message : "Não foi possível colar a foto.");
    }
  }

  async function salvarJogador(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setMensagem(null);

    const tecnico = posicaoJogador === "Técnico";
    const numero = tecnico ? null : Number(numeroJogador);
    if (!tecnico && (!Number.isInteger(numero) || Number(numero) < 0 || Number(numero) > 999)) {
      setMensagem("Informe um número de camisa válido.");
      return;
    }

    setSalvandoJogador(true);

    try {
      const editando = Boolean(jogadorEditandoId);
      const response = await fetch(
        editando
          ? `${API_URL}/api/admin/elenco/${jogadorEditandoId}`
          : `${API_URL}/api/admin/elenco`,
        {
          method: editando ? "PUT" : "POST",
          headers: { "Content-Type": "application/json", ...authHeaders },
          body: JSON.stringify({
            nome_completo: nomeCompletoJogador,
            nome_guerra: nomeGuerraJogador,
            posicao: posicaoJogador,
            nacionalidade: nacionalidadeJogador.trim() || "Brasil",
            nascimento: nascimentoJogador,
            numero,
            foto_data_url: fotoJogadorDataUrl || null,
            remover_foto: removerFotoJogador,
          }),
        }
      );

      const body = await response.json().catch(() => ({}));
      if (!response.ok) {
        setMensagem(body.detail ?? "Não foi possível salvar o jogador.");
        return;
      }

      setMensagem(
        editando
          ? `${body.nome_guerra} atualizado no elenco.`
          : `${body.nome_guerra} adicionado ao elenco.`
      );
      limparFormularioJogador();
      await carregarDados();
    } finally {
      setSalvandoJogador(false);
    }
  }

  async function excluirJogador(jogador: JogadorAdmin) {
    if (!window.confirm(`Remover ${jogador.nome_guerra} do elenco atual?`)) return;

    const response = await fetch(`${API_URL}/api/admin/elenco/${jogador.id}`, {
      method: "DELETE",
      headers: { ...authHeaders },
    });

    if (!response.ok) {
      const body = await response.json().catch(() => ({}));
      setMensagem(body.detail ?? "Não foi possível remover o jogador.");
      return;
    }

    if (jogadorEditandoId === jogador.id) limparFormularioJogador();
    setMensagem(`${jogador.nome_guerra} removido do elenco.`);
    await carregarDados();
  }

  async function salvarCapaSite(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setMensagem(null);

    const response = await fetch(`${API_URL}/api/admin/capa`, {
      method: "PUT",
      headers: { "Content-Type": "application/json", ...authHeaders },
      body: JSON.stringify({
        ativo: capaAtiva,
        tipo: capaTipo,
        media_url: capaMediaUrl.trim() || null,
      }),
    });

    const body = await response.json().catch(() => ({}));

    if (!response.ok) {
      setMensagem(body.detail ?? "Não foi possível salvar a capa.");
      return;
    }

    setCapaAtiva(body.ativo);
    setCapaTipo(body.tipo);
    setCapaMediaUrl(body.media_url ?? "");
    setMensagem(body.ativo ? "Capa ativada com sucesso." : "Capa salva e desativada.");
  }

  if (!token) {
    return (
      <main className="admin-shell admin-login-shell">
        <section className="admin-login-card">
          <div className="admin-brand-row">
            <img src="/central-do-galo-logo.png" alt="Central do Galo" />
            <div>
              <span className="eyebrow">ÁREA RESTRITA</span>
              <h1>Admin</h1>
            </div>
          </div>
          <p>Entre para gerenciar o elenco, páginas, perfis do X e canais do YouTube.</p>
          <form className="admin-form" onSubmit={entrar}>
            <label>
              E-mail
              <input type="email" value={email} onChange={(e) => setEmail(e.target.value)} required />
            </label>
            <label>
              Senha
              <input type="password" value={senha} onChange={(e) => setSenha(e.target.value)} required />
            </label>
            {erroLogin && <div className="admin-alert admin-alert-error">{erroLogin}</div>}
            <button className="admin-primary-button" type="submit" disabled={carregandoLogin}>
              {carregandoLogin ? "Entrando..." : "Entrar"}
            </button>
          </form>
        </section>
      </main>
    );
  }

  return (
    <main className="admin-shell">
      <header className="admin-header">
        <div>
          <span className="eyebrow">CENTRAL DO GALO</span>
          <h1>Painel administrativo</h1>
          <p>Gerencie o elenco, páginas públicas, perfis do Radar do X e canais do YouTube.</p>
        </div>
        <div style={{ display: "flex", gap: "10px", alignItems: "center" }}>
          <button
            className="admin-secondary-button"
            type="button"
            onClick={() => {
              window.location.href = "/";
            }}
          >
            Abrir site
          </button>
          <button className="admin-secondary-button" type="button" onClick={sair}>Sair</button>
        </div>
      </header>

